# Choose ONE provider (default: gemini). Supported: gemini | openai | anthropic | openai-compatible | ollama
# WORKSHOP_AI_PROVIDER=gemini

# --- Google Gemini (default) ---
GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI (WORKSHOP_AI_PROVIDER=openai) ---
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=replace-with-a-model-your-account-can-use

# --- Anthropic Claude (WORKSHOP_AI_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# ANTHROPIC_MODEL=replace-with-a-model-your-account-can-use

# --- OpenAI-compatible API (WORKSHOP_AI_PROVIDER=openai-compatible) ---
# OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# OPENAI_COMPATIBLE_API_KEY=replace-if-required
# OPENAI_COMPATIBLE_MODEL=replace-with-the-provider-model-id

# --- Ollama (WORKSHOP_AI_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=replace-with-a-model-you-pulled
